<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries><package android:name="org.lsposed.manager"/></queries>
  <application
      android:label="VPN Visibility"
      android:icon="@drawable/ic_launcher"
      android:allowBackup="false"
      android:hasCode="true"
      android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <meta-data android:name="xposedmodule" android:value="true"/>
    <meta-data android:name="xposedminversion" android:value="82"/>
    <meta-data android:name="xposeddescription" android:value="Experimental selective VPN API masking. Requires root and LSPosed."/>
    <meta-data android:name="xposedscope" android:value="com.vkontakte.android"/>
  </application>
</manifest>
